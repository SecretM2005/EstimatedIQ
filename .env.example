# ============================================================================
# EstimateIQ Backend – Umgebungsvariablen
# Kopieren nach .env und ausfüllen. .env ist gitignored.
# ============================================================================

# ── Lokale Entwicklung (Standard) ───────────────────────────────────────────
# Ohne DATABASE_URL läuft SQLite (data/estimateiq_angebot.db).
# AUTH_DISABLED=true schaltet den Login ab → fester Dev-Tenant.
AUTH_DISABLED=true

# ── Supabase (Demo / Produktion) ────────────────────────────────────────────
# 1) Schema einspielen: migrations/001_supabase_schema.sql im SQL Editor ausführen
# 2) Connection String: Dashboard → Project Settings → Database
#    → Connection string → "Session pooler" (Port 5432) wählen
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-passwort>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# 3) Projekt-URL (für JWT-Verifikation über JWKS bei neuen Supabase-Projekten)
# SUPABASE_URL=https://<project-ref>.supabase.co

# 4) Nur bei Legacy-Projekten mit HS256 Shared Secret nötig
#    (Dashboard → Project Settings → API → JWT Secret). Sonst weglassen.
# SUPABASE_JWT_SECRET=

# 5) Auth im Deployment IMMER aktiv lassen:
# AUTH_DISABLED=false

# ── CORS ────────────────────────────────────────────────────────────────────
# Kommagetrennte Frontend-Origins; "*" nur für lokale Entwicklung.
# CORS_ORIGINS=https://estimateiq.vercel.app
