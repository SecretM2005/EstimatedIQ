# ============================================================================
# EstimateIQ Frontend – Umgebungsvariablen (Vite)
# Kopieren nach .env.local und ausfüllen. .env.local ist gitignored.
# ============================================================================

# Backend-URL. Leer lassen für lokale Entwicklung (Vite-Proxy → localhost:8000).
# Im Deployment z. B.: https://estimateiq-api.up.railway.app
VITE_API_URL=

# Supabase Auth. Beide leer lassen → App läuft OHNE Login (lokale Entwicklung).
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
